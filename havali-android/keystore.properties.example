# Bu dosyayı keystore.properties olarak kopyalayın (repoya EKLEMEYİN, .gitignore'da).
# Keystore oluşturmak için:
#   keytool -genkey -v -keystore havali-release.jks -keyalg RSA -keysize 2048 -validity 10000 -alias havali
storeFile=havali-release.jks
storePassword=CHANGE_ME
keyAlias=havali
keyPassword=CHANGE_ME
